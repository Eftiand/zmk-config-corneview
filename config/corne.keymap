#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        tp: tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREFERRED";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB  |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U    |  I  |  O  |  P  |  Å   |
            // | CTRL  |  A  |  S  |  D  |  F  |  G  |     |  H  |  J    |  K  |  L  |  Ö  |  Ä   |
            // | SHFT  |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M    |  ,  |  .  |  -  |  ESC  |
            //                               | GUI | LWR | SPC |     | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P      &kp LBKT
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI   &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp MINUS  &lt 3 ESCAPE
                         &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB  |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  |  BSPC  |
            // | BTCLR | BT1 | BT2 | BT3 | BT4 | BT5 |     | LFT | DWN |  UP | RGT |     |       |
            // | SHFT  |     |     |     |     |     |     |     |     |     |     |     |       |
            //                               | GUI |     | SPC |     | ENT |     | ALT |

            bindings = <
&kp TAB    &kp NUMBER_1  &kp N2  &kp N3    &kp N4  &kp N5       &kp N6    &kp N7    &kp N8    &kp N9     &trans  &trans
&trans     &trans        &trans  &trans    &trans  &trans       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT  &trans        &trans  &trans    &trans  &trans       &trans    &trans    &trans    &trans     &trans  &trans
                                 &kp LGUI  &trans  &kp SPACE    &kp RET   &trans    &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB  |  !  |  "  |  #  |  ¤  |  %  |     |  &  |  /  |  (  |  )  |  =  |  DEL  |
            // | CTRL  |     |     |     |     |     |     |     |     |  [  |  ]  |  \  |  `    |
            // | SHFT  |  <  |  @  |  £  |  $  |  €  |     |  {  |  }  |  ´  |  `  |  |  |  ~    |
            //                               | GUI |     | SPC |     | ENT |     | ALT |

            bindings = <
&kp TAB    &kp LS(N1)      &kp LS(N2)      &kp LS(N3)      &kp RA(N4)      &kp LS(N5)        &kp LS(NUMBER_6)  &kp LS(N7)      &kp LS(N8)      &kp LS(N9)      &kp LS(N0)      &kp DELETE
&kp LCTRL  &kp LS(LA(N1))  &kp LS(LA(N2))  &kp LS(LA(N3))  &kp LS(LA(N4))  &kp LA(LS(N5))    &kp LS(LA(N6))    &kp LS(LA(N7))  &kp LA(LS(N8))  &kp LA(LS(N9))  &kp LA(LS(N0))  &kp RIGHT_BRACKET
&kp LSHFT  &kp LA(N1)      &kp RA(N2)      &kp RA(N3)      &kp RA(N4)      &kp RA(N5)        &kp RA(NUMBER_6)  &kp RA(N7)      &kp RA(N8)      &kp RA(N9)      &kp RA(N0)      &kp TILDE
                                           &kp LGUI        &trans          &kp SPACE         &kp RET           &trans          &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
